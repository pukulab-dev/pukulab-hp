{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/works",
      "permanent": true
    }
  ]
}
